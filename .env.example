# Copy to .env.local and fill in. Never commit .env.local.
#
# All variables are OPTIONAL. With none of them set, the app runs in "local
# mode": an in-memory store and a development identity, no sign-in required.

# --- Supabase (enables real auth + Postgres persistence) --------------------
# Project settings -> API. The anon key is a public client key; it is safe in a
# browser bundle because row level security is what protects the data.
# The service-role key is NOT used by this app and must never be committed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- GitHub API -------------------------------------------------------------
# A fine-grained personal access token with PUBLIC read access only.
# Without it GitHub allows 60 requests/hour, which is enough for roughly two
# profile imports. With it, 5,000/hour.
GITHUB_TOKEN=
